; Riddick VR settings. Copy to riddick_vr.ini next to opengl32.dll / DarkAthena.exe
; (game folder or dist/). Missing file = built-in defaults. [VR] section only.
[VR]
; --- Turning ---
SnapAngleDeg=45        ; snap-turn step (15-90)
SmoothTurnSpeed=20.0   ; smooth-turn curve gain (1-60)
TurnDeadzone=0.20      ; right-stick smooth deadzone (0.05-0.60)
DialogueDeadzone=0.50  ; menu/dialogue direction deadzone (0.15-0.80)
InteractButton=0       ; 0 = face A, 1 = left Y (repurposes Eyeshine)
; --- Head look (GH #45) ---
; Gain matching HMD degrees to engine degrees. CALIBRATION: stand in-game,
; turn your head exactly 90 deg right. If the view turned MORE, lower both
; values proportionally (e.g. turned ~100 deg -> multiply by 0.9). If LESS,
; raise them. Repeat for pitch (nod 45 deg). Defaults = legacy feel.
LookSensitivityYaw=445.6    ; (50-2000)
LookSensitivityPitch=445.6  ; (50-2000)
; --- Locomotion ---
MoveDeadzone=0.22      ; left-stick radial deadzone (0.05-0.60)
; --- Comfort (#9) ---
ComfortEnabled=1       ; locomotion vignette proxy on/off
ComfortStrength=1.0    ; vignette gain (0-2)
ComfortMaxDim=0.45     ; peripheral dimming ceiling, 0 disables (0-1)
; --- Body (#11, #13, #14) ---
Seated=0               ; seated play: height compensation, no auto-crouch
SeatedEyeOffset=0.15   ; seated eye height compensation meters (0-0.60)
StandingEyeHeight=0.0  ; baseline override meters (0 = auto-calibrate)
WorldScale=1.0         ; tracking-space scale (0.5-2.0)
Southpaw=0             ; left-dominant mapping
; --- Gestures (#15) ---
GestureDebounceMs=180  ; per-action debounce (120-250)
; --- Diegetic weapon ammo quad (#40) ---
; Source rectangle as fractions of the rendered eye image. X/Y are top-left;
; width/height are clamped so the crop stays inside the image.
AmmoQuadCropX=0.75
AmmoQuadCropY=0.75
AmmoQuadCropW=0.23
AmmoQuadCropH=0.23
; --- Native arm/hand mesh (GH #46) ---
; 1 = draw the real Riddick arm/hand geometry baked from the game's .xmd models
; (behind the procedural overlay, which stays the default and the fallback).
; PROVISIONAL / UNTUNED: the placement is derived from the mesh bounds and must
; be calibrated on a headset. Scale is model units -> metres; the offsets are
; hand-local metres (X right, Y up, Z back toward the forearm).
NativeHands=0
NativeHandScale=0.033
NativeHandOffsetX=0
NativeHandOffsetY=0
NativeHandOffsetZ=0
; Native hand orientation correction (GH #64), degrees applied in the hand-local
; frame (yaw about up, pitch about right, roll about the forearm axis). Use these
; to correct the provisional axis basis on a headset without a code change.
NativeHandYaw=0
NativeHandPitch=0
NativeHandRoll=0
; --- Native hand texture (GH #61) ---
; 1 = modulate the real Riddick skin/scar diffuse (DXT1, baked from the game's
; Content/Models.xtc) over the lit native hand mesh; the flat skin tone stays
; the fallback when the texture is disabled or unavailable.
; VFlip is PROVISIONAL (UV orientation is not yet validated on a headset);
; set to 1 if the texture reads vertically mirrored.
; GH #61: if the hand still reads white, paste the `NativeHand GL state:` line
; from the log into the issue.
NativeHandTexture=1
NativeHandTextureVFlip=0
; --- Native hand pose (GH #58) ---
; 1 = draw the offline-posed mesh variant baked from a shipped first-person .xsa
; clip (FK + influence-weighted skinning; ADR-0443) instead of the bind T-pose
; geometry. 0 = bind (default). The baked pose is an evidence-backed but
; unvalidated VR fit -- compare both on a headset before enabling it.
NativeHandPose=0
; GH #64: 1 = also draw the IK upper-arm tube (shoulder to elbow) with native
; hands. 0 = off (the tube does not join the native mesh and reads as a stray block).
NativeHandUpperArm=0
; GH #46: 1 = fade the hands to 25% while a weapon is held (trigger or two-handed
; grip); a boxer guard never fades. 0 = never fade.
HandFadeWhenWeapon=1
; --- Front-of-HMD block/guard window (GH #62) ---
; Head-local hand window (metres relative to the HMD: +Y up, -Z forward into the
; view). Block = both fists held in front of the face within this window; a low
; rest hold (Y below GuardYMin) does NOT block, and a fast swing outside the
; window always fires. Keep GuardYMin well above a resting hand height.
GuardYMin=-0.16     ; lowest hand height that counts as a block (head-local m)
GuardYMax=0.32      ; highest hand height that counts as a block
GuardZMin=-0.60     ; farthest forward the guard may be held
GuardZMax=-0.12     ; nearest to the face (smaller magnitude = closer)
GuardMaxHandSpan=0.50   ; max |leftX - rightX| shield width (m)
; --- Swing-driven strike thresholds (GH #65) ---
; A punch/hook/uppercut fires on controller *velocity* (not a both-trigger
; chord). Units: velocities in m/s, positions in head-local metres (+Y up,
; -Z forward). Defaults are the committed first pass; lower a magnitude to make
; that strike easier, raise it to make it stiffer. Raising the hands into guard
; (upward, ~zero forward) is never a strike by construction.
StrikeForwardVz=-1.20   ; forward jab: hand Vz below this (m/s, negative)
StrikeForwardMaxZ=-0.10 ; ...and the hand ahead of the view plane (z < this)
StrikeHookVx=1.35       ; hook: |hand Vx| above this
StrikeHookVz=-0.15      ; ...and travelling forward (Vz below this)
StrikeUppercutVy=1.35   ; uppercut: hand Vy above this
StrikeUppercutMaxY=-0.10 ; ...starting below the view (y < this)
StrikeUppercutVz=-0.20  ; ...with some forward travel
StrikeCrossVx=1.10      ; dual cross-slash: opposing |Vx| swing
; GH #65: 1 = rotate controller world velocity into the HMD yaw frame so swings
; register whichever way you face; 0 = legacy world axes (only facing stage -Z).
HeadLocalVelocity=1
; GH #65: ms (0-250) a melee click stays held; 0 = legacy instant down+up.
MeleeClickHoldMs=60
; GH #62: guard pose hold time to engage (ms), survive-pose-loss time (ms), and
; the hand speed (m/s) below which the hands count as steady.
GuardEngageMs=40
GuardReleaseMs=80
GuardSteadySpeed=1.4
; GH #52: combat stance trigger thresholds (enter/exit, 0-1) and hold time (ms);
; MeleeRequiresStance=1 ignores swings outside the stance (0 = swings always live).
StanceEnterTrigger=0.85
StanceExitTrigger=0.60
StanceHoldMs=100
MeleeRequiresStance=0
; --- Engine viewmodel suppression (GH #66, approach 2) ---
; 1 = skip the engine's own first-person arms/hands at the draw level so only
; the VR/native hands are visible (the duplicate-hands fix). Default 0.
; The pass signature is PROVISIONAL (a mid-frame depth-only-clear window); the
; hook logs "Viewmodel suppression [#N]: last frame draws=.. suppressed=.." so
; you can confirm the window before trusting it. Approach 1 (the RPG
; `noviewmodel` bit) was proven inert in ADR-0438.
SuppressEngineViewmodel=0
; Which boundary opens the suppression window: 1 = depth-only clear (default),
; 0 = never open (inert even when suppression is enabled).
ViewmodelDepthClearWindow=1
; GH #63/#66: log the engine's per-frame GL pass signature every 300 frames
; ("Viewmodel pass trace"). Tokens: C colour clear, D depth-only clear, P<near>
; perspective load, O ortho load, d<n> draw run. Paste it in the issue to pin
; the real first-person pass boundary. 0 = off.
ViewmodelTrace=0
; GH #66: what opens the viewmodel window. -1 = derive from
; ViewmodelDepthClearWindow; 0 none, 1 depth-only clear, 2 near-plane drop
; (a perspective load with a much shorter near plane), 3 either.
ViewmodelWindowOpener=-1
; GH #66: near-plane-drop opens when near < worldNear * this (0.05 - 0.95).
ViewmodelNearRatio=0.5
; GH #67: drive the engine's own arms with the dominant controller instead of
; hiding them. Opt-in, experimental; ignored while SuppressEngineViewmodel=1.
; Needs a headset run to tune the values below.
DriveEngineViewmodel=0
; GH #67: engine units per metre (provisional 30.3 ~ 1/0.033).
ViewmodelUnitsPerMeter=30.3
; GH #67: where the engine draws the viewmodel, in head space (metres, -Z forward).
ViewmodelAnchorX=0.18
ViewmodelAnchorY=-0.22
ViewmodelAnchorZ=-0.38
; GH #67: extra rotation on the controller orientation (degrees).
ViewmodelDriveYaw=0
ViewmodelDrivePitch=0
ViewmodelDriveRoll=0
